{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vx-m-open",
  "version": "1.1.0",
  "identifier": "io.github.vxmopen.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VXMOpen",
        "width": 920,
        "height": 660,
        "minWidth": 780,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://vxmo.cting.vip https://api.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://vxmo.cting.vip/latest.json",
        "https://github.com/xiaoRui278/vx-m-open/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNTkyOUMyOTgxOUE1NkUKUldSdXBSbVl3aWxab2pMclpzYlFrRGNDWmN6N0NBaFFzTFI1ZHhvMGJCdzFPd1pTOWcxelFGUGQK"
    }
  }
}
